{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beads PM",
  "version": "0.1.0",
  "identifier": "com.beads.pm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beads PM",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "numbering.json"
    ]
  }
}
