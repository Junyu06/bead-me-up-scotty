{
  "name": "beads-pm-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node tests/run.mjs",
    "test:ui": "node tests/header.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "format": "prettier --write src tests docs",
    "check:format": "prettier --check src tests docs",
    "lint": "../node_modules/.bin/eslint src tests"
  },
  "dependencies": {
    "@xyflow/react": "12.11.0",
    "lucide-react": "1.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
